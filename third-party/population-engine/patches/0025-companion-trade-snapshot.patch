 	}
 
+	// RAGNAROKMAC (Goal 2): note a companion's inventory before the items move, so the equip
+	// pass below acts only on what this trade brought in, not on the companion's own things.
+	if (population_engine_is_population_pc(sd->id))
+		population_engine_companion_trade_snapshot(sd);
+	if (population_engine_is_population_pc(tsd->id))
+		population_engine_companion_trade_snapshot(tsd);
+
 	// trade is accepted and correct.
 	for( trade_i = 0; trade_i < 10; trade_i++ ) {

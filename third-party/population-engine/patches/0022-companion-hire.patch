From 0000000000000000000000000000000000000022
Subject: [PATCH] Hired companions: settings, recruiter script commands, @companion terms

Settings -> Population -> Companions can make a companion something you hire:
of your own class tier, at your level, for zeny and/or an item, from the
Companions panel or from a Companion Recruiter in town. Free choice (any job)
stays the default.

--- a/src/custom/battle_config_init.inc
+++ b/src/custom/battle_config_init.inc
@@ -61,3 +61,7 @@
 { "population_engine_vending_enable",&battle_config.population_engine_vending_enable,0,0,1,},
 { "population_engine_arena_custom_pool",&battle_config.population_engine_arena_custom_pool,0,0,1,},
 { "population_engine_path_attempts",&battle_config.population_engine_path_attempts,16,1,256,},
+{ "population_engine_companion_hire",&battle_config.population_engine_companion_hire,0,0,2,},
+{ "population_engine_companion_hire_zeny_per_level",&battle_config.population_engine_companion_hire_zeny_per_level,0,0,1000000,},
+{ "population_engine_companion_hire_item",&battle_config.population_engine_companion_hire_item,0,0,INT_MAX,},
+{ "population_engine_companion_hire_item_amount",&battle_config.population_engine_companion_hire_item_amount,0,0,30000,},
--- a/src/custom/battle_config_struct.inc
+++ b/src/custom/battle_config_struct.inc
@@ -121,3 +121,11 @@
 /// global in population_engine.cpp. This field signals that a custom pool was configured (1=yes,0=no).
 int32 population_engine_arena_custom_pool;
 int32 population_engine_path_attempts;
+/// Companions: 0 = free choice (any job, as before); 1 = hired from the
+/// Companions panel; 2 = hired from a Companion Recruiter NPC. Hired companions
+/// are of the player's own class tier and level, for the fee below.
+int32 population_engine_companion_hire;
+/// The hiring fee: zeny per level of the companion, and/or an item and amount.
+int32 population_engine_companion_hire_zeny_per_level;
+int32 population_engine_companion_hire_item;
+int32 population_engine_companion_hire_item_amount;
--- a/src/custom/script.inc
+++ b/src/custom/script.inc
@@ -292,5 +292,62 @@
 BUILDIN_FUNC(population_vendor_price)
 {
 	population_engine_set_mod_vendor_price(script_getstr(st, 2), script_getnum(st, 3));
+	return SCRIPT_CMD_SUCCESS;
+}
+
+/*==========================================
+ * Hired companions, for the Companion Recruiter (npc/custom/population/recruiter.txt).
+ *
+ * companion_hire_jobs()      the jobs the attached player may hire, ':'-joined
+ * companion_hire_fee()       the zeny it costs them (their level x the fee)
+ * companion_hire("<job>")    hire one: 1 on success, 0 if refused; the reason
+ *                            or what was paid is shown to the player
+ *------------------------------------------*/
+BUILDIN_FUNC(companion_hire_jobs)
+{
+	map_session_data* sd;
+	if( !script_rid2sd(sd) ){
+		script_pushconststr(st, "");
+		return SCRIPT_CMD_SUCCESS;
+	}
+	std::string out;
+	for (uint16_t job : population_engine_companion_hire_jobs(sd)) {
+		if (!out.empty())
+			out += ':';
+		out += population_engine_hire_job_name(job);
+	}
+	script_pushstrcopy(st, out.c_str());
 	return SCRIPT_CMD_SUCCESS;
 }
+
+BUILDIN_FUNC(companion_hire_fee)
+{
+	map_session_data* sd;
+	if( !script_rid2sd(sd) ){
+		script_pushint(st, 0);
+		return SCRIPT_CMD_SUCCESS;
+	}
+	script_pushint(st, static_cast<int32>(population_engine_companion_hire_zeny(sd)));
+	return SCRIPT_CMD_SUCCESS;
+}
+
+BUILDIN_FUNC(companion_hire)
+{
+	map_session_data* sd;
+	if( !script_rid2sd(sd) ){
+		script_pushint(st, 0);
+		return SCRIPT_CMD_SUCCESS;
+	}
+	const uint16_t job = population_engine_job_id_from_name(script_getstr(st, 2));
+	std::string msg;
+	uint32_t made = 0;
+	if (job == 0)
+		msg = "Unknown job.";
+	else if (!population_engine_can_recruit_companion(sd))
+		msg = "Your party is at the companion limit.";
+	else
+		made = population_engine_companion_hire(sd, job, nullptr, true, msg);
+	clif_displaymessage(sd->fd, msg.c_str());
+	script_pushint(st, made != 0 ? 1 : 0);
+	return SCRIPT_CMD_SUCCESS;
+}
--- a/src/custom/script_def.inc
+++ b/src/custom/script_def.inc
@@ -24,3 +24,6 @@
 BUILDIN_DEF(population_vendor_callouts, "si??"),
 BUILDIN_DEF(population_vendor_limit, "si"),

+		return 0;
+	}
 	if (strcmpi(cmd, "jobs") == 0) {
 		clif_displaymessage(fd, "=== Draggable companion jobs ===");
 		clif_displaymessage(fd, "1st: Novice Swordsman Mage Archer Acolyte Merchant Thief");
